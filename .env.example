PUBLIC_BASE_URL=https://your-public-host.example
MODEL_URL=http://127.0.0.1:8080/v1
MODEL_NAME=bartowski/Llama-3.2-1B-Instruct-GGUF:Q4_K_M
TWILIO_ACCOUNT_SID=AC...
TWILIO_API_KEY_SID=SK...
TWILIO_API_KEY_SECRET=...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+15551234567
DEEPGRAM_API_KEY=...
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# stream uses Deepgram Media Streams; trial uses Twilio Gather/Say on /twilio/voice
TWILIO_VOICE_MODE=stream
ADMIN_TOKEN=choose-a-long-random-value

# Opt-in, single-patient caregiver SMS alerts; mock never sends real SMS.
SMS_ALERTS_ENABLED=false
SMS_ALERT_PROVIDER=mock
PATIENT_PHONE_NUMBER=+15551234567
CAREGIVER_PHONE_NUMBER=+15557654321
# Optional separate SMS-capable sender; falls back to TWILIO_FROM_NUMBER.
TWILIO_SMS_FROM_NUMBER=
PHONE_ALERTS_DATABASE=data/phone-alerts.sqlite3

# Standalone Builder 3 app only (src.api.builder3_server:create_app --factory)
PROVIDER=mock
SMOKE_TEST_ENABLED=false
SCHEDULER_ENABLED=false
API_TOKEN=replace-with-a-private-random-token
DATABASE_PATH=data/orchestration.sqlite3
VOICE_URL=

# Opt-in backend call logging. Only PATIENT_PHONE_NUMBER maps to this user ID.
SUPABASE_CALL_LOGGING=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=
SUPABASE_USER_ID=
CALL_LOG_DIRECTORY=data/call-logs

# Send a patient-reported summary back to the call participant after each completed call.
# Independent of the earlier concern-only SMS alert feature. Mock sends no real texts.
POST_CALL_SMS_ENABLED=false
POST_CALL_SMS_PROVIDER=mock
POST_CALL_SMS_DATABASE=data/post-call-sms.sqlite3
# Only +1 supports ten-digit local numbers. Prefer explicit +countrycode strings.
SMS_DEFAULT_COUNTRY_CODE=1
